# Strapi API token used to authenticate requests to the backend.
# Required at BUILD TIME because the site is prerendered — set this in
# Vercel (Settings → Environment Variables) as well as locally.
# Provisioned by maria-ol-backend/terraform - run `npm run secrets:pull`
# instead of filling this in by hand.
API_KEY=your-strapi-api-token-here

# Optional: develop against a local Strapi instead of prod. Leave unset for prod.
# With a local backend, API_KEY must be a token created in the LOCAL Strapi admin
# (don't use secrets:pull for this).
# PUBLIC_BACKEND_URL=http://localhost:1337
